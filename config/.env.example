# Meme Engine Configuration for Render Deployment
# Copy this to .env and fill in your values
# REQUIRED for Render: TELEGRAM_BOT_TOKEN, ANKR_API_KEY, HELIUS_API_KEY
# OPTIONAL: SOLANA_PRIVATE_KEY (only for live trading), BASE_PRIVATE_KEY, GOLDRUSH_API_KEY

# ===== TELEGRAM (REQUIRED) =====
# Bot token from @BotFather - already configured: @memeonmoneybot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID where bot sends push updates (auto-learned on /start, but can pre-set)
TELEGRAM_CHAT_ID=

# ===== BLOCKCHAIN RPC (REQUIRED) =====
# Ankr Advanced API - FREE tier at https://www.ankr.com/ (multi-chain: Base, Solana via multichain endpoint)
ANKR_API_KEY=your_ankr_api_key_here

# Helius Solana RPC - FREE tier 1M credits/mo at https://helius.dev/ (REQUIRED for real holder data)
HELIUS_API_KEY=your_helius_api_key_here

# Solana (paper trading uses demo wallet - no private key needed for paper mode)
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Base (frozen by default - enable when ready)
BASE_PRIVATE_KEY=
BASE_RPC_URL=https://rpc.ankr.com/base/${ANKR_API_KEY}

# Robinhood Chain (frozen by default)
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.goldrushdata.com/v1/robinhood-mainnet

# GoldRush (Covalent) for Robinhood Chain
GOLDRUSH_API_KEY=

# ===== OPTIONAL APIs =====
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
ONE_INCH_API_KEY=
JUPITER_API_KEY=
