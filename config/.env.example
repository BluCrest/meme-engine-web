# Meme Engine Configuration
# Copy this to .env and fill in your values

# Solana
SOLANA_PRIVATE_KEY=your_solana_private_key_base58
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Base
BASE_PRIVATE_KEY=your_base_private_key_hex
BASE_RPC_URL=https://mainnet.base.org

# Robinhood Chain (enable when ready)
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_RPC_URL=

# Ankr Advanced API (FREE tier: 50 req/min, multi-chain)
# Get key at https://www.ankr.com/
ANKR_API_KEY=your_ankr_api_key_here

# API Keys (optional but recommended)
HELIUS_API_KEY=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
ONE_INCH_API_KEY=
JUPITER_API_KEY=
